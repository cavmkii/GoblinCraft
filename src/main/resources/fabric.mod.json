{
  "schemaVersion": 1,
  "id": "seancraft",
  "version": "${version}",
  "name": "SeanCraft",
  "description": "Survival as a raid game: safe spawns and hideouts, losing your kit when you die out there, a Tetris inventory, body-part health, gear built from parts, a passive tree and use-skills, plus Joe and Sean.",
  "authors": ["cavmkii"],
  "contact": {
    "sources": "https://github.com/cavmkii/SeanCraft"
  },
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["com.cavmkii.seancraft.SeanCraft"],
    "client": ["com.cavmkii.seancraft.client.SeanCraftClient"]
  },
  "mixins": [
    "seancraft.mixins.json",
    {"config": "seancraft.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
