{
  "schemaVersion": 1,
  "id": "seancraft",
  "version": "${version}",
  "name": "SeanCraft",
  "description": "Joe the goblin, Sean the travelling merchant and the Baby Wars, plus a PoE-style passive web, Valheim skills, and TarkoValheim raids, hideouts, body health, modular gear and a Tetris inventory.",
  "authors": ["cavmkii"],
  "contact": {
    "sources": "https://github.com/cavmkii/SeanCraft"
  },
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["com.cavmkii.seancraft.SeanCraft"],
    "client": ["com.cavmkii.seancraft.client.SeanCraftClient"]
  },
  "mixins": [
    "seancraft.mixins.json",
    {"config": "seancraft.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
